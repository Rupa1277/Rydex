{
  "expo": {
    "name": "RideSafe",
    "slug": "RideSafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow RideSafe to select emergency contacts from your address book."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow RideSafe to include your location in an emergency alert."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
